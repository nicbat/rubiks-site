{
  "name": "last-layer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs demo",
    "dev:demo": "npm run dev --",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --import ./scripts/svelte-loader.mjs --test tests/*.test.js",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test:coverage": "node --import ./scripts/svelte-loader.mjs --test --experimental-test-coverage --test-coverage-include=\"src/**/*.js\" tests/*.test.js",
    "test:build": "npm run build && node scripts/check-build.mjs",
    "benchmark": "node --import ./scripts/svelte-loader.mjs scripts/benchmark.mjs",
    "verify": "npm run check && npm test && npm run test:e2e && node scripts/check-build.mjs",
    "check": "svelte-check --tsconfig ./jsconfig.json",
    "dev:guest": "node scripts/dev.mjs guest",
    "dev:backend": "node scripts/dev.mjs backend",
    "backend:start": "node scripts/backend.mjs start",
    "backend:stop": "node scripts/backend.mjs stop",
    "backend:reset": "node scripts/backend.mjs reset",
    "test:integration": "node scripts/test-integration.mjs",
    "test:integration:e2e": "node scripts/test-integration.mjs --browser"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "acorn": "^8.15.0",
    "cubing": "^0.63.0",
    "marked": "^18.1.1",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "supabase": "2.114.0",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^7.1.0"
  },
  "dependencies": {
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@fontsource-variable/saira": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@supabase/auth-js": "^2.118.0",
    "bits-ui": "^2.19.5",
    "clsx": "^2.1.1",
    "dseg": "^0.46.0",
    "svelte": "^5.57.2",
    "tailwind-merge": "^3.7.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
