{
  "name": "last-layer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "test:e2e": "npm run build && playwright test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**/*.js\" tests/*.test.js",
    "test:build": "npm run build && node scripts/check-build.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "verify": "npm test && npm run test:e2e && node scripts/check-build.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "acorn": "^8.15.0",
    "cubing": "^0.63.0",
    "prettier": "^3.9.9",
    "vite": "^7.1.0"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0"
  }
}
